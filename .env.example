# PlacementIQ Environment Variables (Sample Configuration)

# Application Port
PORT=5173
VITE_APP_NAME="PlacementIQ"
VITE_INSTITUTION_NAME="Apex Institute of Technology"

# Database Configuration (PostgreSQL Production Target)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=placementiq_db
DB_USER=placementiq_user
DB_PASSWORD=your_secure_db_password_here

# JWT Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRATION_MS=86400000

# External GitHub API Integration
# Required for elevated rate limits (5,000 req/hr vs 60 req/hr unauthenticated)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_github_token_here

# AI Provider Configuration (Google Gemini / OpenAI / Local Rule-based)
AI_PROVIDER=local_rule_based
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Isolated Code Execution Sandbox Service
CODE_RUNNER_SERVICE_URL=http://localhost:8080/sandbox
CODE_RUNNER_TIMEOUT_MS=5000
CODE_RUNNER_MEMORY_LIMIT_MB=128
